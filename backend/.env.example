# Backend Environment Configuration
# JAI HIND SPORTS

PORT=5000
NODE_ENV=development

# Allowed External Frontend Origin(s) for CORS (comma-separated if multiple)
# On Vercel unified deployment, same-origin browser requests are automatically allowed
# In local development, localhost:3000 and localhost:5173 are automatically allowed
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting Configuration (per active container)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ENQUIRY_RATE_LIMIT_MAX=10

# Reverse proxy trust:
# On Vercel, defaults to 1 automatically (trusts 1 proxy hop from Vercel Edge Network)
# For standalone servers without reverse proxy, defaults to false
TRUST_PROXY=1
