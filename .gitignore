# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production build outputs
dist/
build/
frontend/dist/
backend/dist/

# Test coverage
coverage/

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets (strictly exclude real secret files)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
credentials*.json

# Always preserve documented example files
!.env.example
!frontend/.env.example
!backend/.env.example

# Deployment tool caches
.vercel
.turbo
