# JAI HIND SPORTS - Environment Configuration
# Note: Real credentials and keys must NEVER be committed to version control.
# On unified Vercel deployment, the frontend and backend run under the same domain.

# Frontend Configuration (see frontend/.env.example)
# On Vercel: use relative /api (or leave empty) for same-domain serverless API calls
VITE_API_BASE_URL=/api

# Backend Configuration (see backend/.env.example)
# On Vercel: TRUST_PROXY defaults to 1 automatically (Vercel Edge Network reverse proxy hop)
# Same-origin requests do not require cross-origin CORS configuration.
# To allow additional external domains, specify ALLOWED_ORIGINS:
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=1
